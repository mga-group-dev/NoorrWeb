// What clients can book, as numbered text cards (no photos), each with its own enquiry link.
// Five cards sit as two wide over three narrow; six as two rows of three. /weddings passes its own items and service.
export function CorporateOfferings({ items = CORPORATE, title = "Five ways to get your team dancing", service = "Corporate show", light = false }) {
  const span = (i) => (items.length === 5 ? (i < 2 ? "lg:col-span-3" : "lg:col-span-2") : "lg:col-span-2");
  return (
    <section className={`${light ? "sec-sky" : "sec-peach"} py-24 md:py-32`} aria-label={title}>
      <div className="wrap">
        <div className="text-center">
          <Ornament className="w-28 text-[#f08a4b] mx-auto" />
          <p className="kicker mt-5">What you can book</p>
          <h2 className="f-display text-[clamp(2.4rem,4.4vw,4rem)] leading-[1.02] mt-4">
            <MaskIn>{title}</MaskIn>
          </h2>
        </div>
        <ul className="mt-14 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-5">
          {items.map((c, i) => (
            <li key={c.title} className={`list-none ${span(i)}`}>
              <Reveal delay={(i % 3) * 0.06} className="group h-full card-grad p-7 md:p-8 flex flex-col transition-transform duration-500 hover:-translate-y-1">
                <span className="f-display text-[3.2rem] leading-none text-grad">0{i + 1}</span>
                <h3 className="f-display text-[1.75rem] leading-tight mt-5">{c.title}</h3>
                <p className="text-[var(--body)] leading-relaxed mt-3 flex-1">{c.body}</p>
                <Link
                  href={`/contact?service=${encodeURIComponent(service)}&topic=${encodeURIComponent(c.title)}`}
                  className="inline-flex items-center gap-2 mt-6 font-semibold text-[var(--accent)] hover:text-[var(--fg)] transition-colors"
                >
                  Enquire <ArrowRight size={17} className="transition-transform group-hover:translate-x-1" aria-hidden="true" />
                </Link>
              </Reveal>
            </li>
          ))}
        </ul>
      </div>
    </section>
  );
}

const CORPORATE_STEPS = [
  ["Tell us the occasion", "Annual day, award night, wellness week or festival party, plus the date and how many people."],
