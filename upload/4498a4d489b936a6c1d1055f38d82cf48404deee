import { CONTACT } from "@/content";

// Contact form → email to Noorr through Resend (https://resend.com). No database or separate backend.
// Env: RESEND_API_KEY (required), CONTACT_TO_EMAIL (defaults to the public contact address),
// CONTACT_FROM_EMAIL (a sender on a domain verified in Resend; the default only delivers to the Resend account owner).
const TO = process.env.CONTACT_TO_EMAIL || CONTACT.email;
const FROM = process.env.CONTACT_FROM_EMAIL || "Noorr Khan Website <onboarding@resend.dev>";
const SERVICES = ["School program", "College event", "Corporate show", "Workshop", "Film or celebrity", "Other"];

// A light per-IP limit so the form can't be used to flood the inbox. In-memory, so it resets per server instance.
const WINDOW_MS = 10 * 60 * 1000;
const MAX_PER_WINDOW = 5;
const hits = new Map();

const escape = (s) => s.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]);

// Same rules the old Python backend enforced.
function validate(body) {
  const f = {
    name: String(body.name ?? "").trim(),
    email: String(body.email ?? "").trim(),
    phone: String(body.phone ?? "").trim(),
    service: String(body.service ?? "").trim(),
    message: String(body.message ?? "").trim(),
  };
  if (f.name.length < 2 || f.name.length > 100) return { error: "Please enter your name." };
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(f.email) || f.email.length > 200) return { error: "Please enter a valid email address." };
  if (!/^[+\d(][\d\s()-]{6,19}$/.test(f.phone)) return { error: "Please enter a valid phone number." };
  if (!SERVICES.includes(f.service)) f.service = "Other";
  if (f.message.length < 5 || f.message.length > 3000) return { error: "Please write a short message (at least 5 characters)." };
  return { form: f };
}

export async function POST(request) {
  if (!process.env.RESEND_API_KEY) {
    return Response.json({ error: "Email sending is not set up yet." }, { status: 503 });
  }

  let body;
  try {
    body = await request.json();
  } catch {
    return Response.json({ error: "Invalid request." }, { status: 400 });
  }
  // Honeypot: a hidden field real visitors never fill in. Pretend success so bots don't retry.
  if (body.company) return Response.json({ ok: true });

  const ip = (request.headers.get("x-forwarded-for") || "").split(",")[0].trim() || "local";
  const now = Date.now();
  const recent = (hits.get(ip) || []).filter((t) => now - t < WINDOW_MS);
  if (recent.length >= MAX_PER_WINDOW) {
    return Response.json({ error: "Too many messages in a short time. Please try again later." }, { status: 429 });
  }
  hits.set(ip, [...recent, now]);

  const { form, error } = validate(body);
  if (error) return Response.json({ error }, { status: 400 });

  const rows = [["Name", form.name], ["Email", form.email], ["Phone", form.phone], ["Event type", form.service]];
  const html = `
    <h2 style="font-family:Arial,sans-serif;margin:0 0 16px">New booking enquiry</h2>
    <table style="font-family:Arial,sans-serif;font-size:14px;border-collapse:collapse">
      ${rows.map(([k, v]) => `<tr><td style="padding:4px 16px 4px 0;color:#6b7080">${k}</td><td style="padding:4px 0"><strong>${escape(v)}</strong></td></tr>`).join("")}
    </table>
    <p style="font-family:Arial,sans-serif;font-size:14px;white-space:pre-wrap;margin-top:16px">${escape(form.message)}</p>
    <p style="font-family:Arial,sans-serif;font-size:12px;color:#6b7080;margin-top:24px">Sent from the contact form on the website. Reply to this email to answer ${escape(form.name)} directly.</p>`;
  const text = `New booking enquiry\n\n${rows.map(([k, v]) => `${k}: ${v}`).join("\n")}\n\n${form.message}`;

  const res = await fetch("https://api.resend.com/emails", {
    method: "POST",
    headers: { Authorization: `Bearer ${process.env.RESEND_API_KEY}`, "Content-Type": "application/json" },
    body: JSON.stringify({
      from: FROM,
      to: [TO],
      reply_to: form.email,
      subject: `Booking enquiry: ${form.service} from ${form.name}`,
      html,
      text,
    }),
  });
  if (!res.ok) {
    const detail = await res.text().catch(() => "");
    console.error("Resend error", res.status, detail);
    return Response.json({ error: "The message could not be sent right now." }, { status: 502 });
  }
  return Response.json({ ok: true });
}
